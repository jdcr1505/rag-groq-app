# WHISPER_MODEL=whisper-large-v3-turbo

# Firma de las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos de usuarios y conversaciones (PostgreSQL en Neon).
# Pega aquí la cadena de conexión que entrega Neon (usa el endpoint "-pooler").
# Si la dejas vacía, en local se usa un archivo SQLite (usuarios.db).
DATABASE_URL=